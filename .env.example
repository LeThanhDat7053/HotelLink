# ===========================================
# HOTEL FRONTEND - CONFIGURATION (DEV LOCAL)
# ===========================================
# Copy file nay thanh .env roi dien gia tri that:
#   cp .env.example .env
#
# File .env chi dung cho DEV LOCAL.
# Tren production, config lay tu server/config.php (xem docs/DEPLOY_DIRECTADMIN.md)
#
# KHONG commit .env len git.
# ===========================================

# ============ API ============
# Base URL cua API (khong co dau / o cuoi)
VITE_API_BASE_URL=https://travel.link360.vn/api/v1

# ============ Authentication ============
# Lien he admin backend de lay credentials rieng cho khach san nay
VITE_API_USERNAME=your_email@example.com
VITE_API_PASSWORD=your_password_here

# ============ Hotel Identity ============
# Lay tu backend admin
VITE_TENANT_CODE=your_tenant_code
VITE_TENANT_ID=1
VITE_PROPERTY_ID=123

# ============ Website ============
# Domain that cua site (khong co dau / o cuoi)
VITE_SITE_BASE_URL=https://yourhotel.example.com

# Ten hien thi tren tab trinh duyet
VITE_APP_NAME=Your Hotel Name

# ============ VR360 (tuy chon) ============
# CDN cho VR360 content
VITE_VR360_CDN_URL=https://travel.link360.vn

# Domain ghep vao panorama_url khi sync scene len backend
VITE_PANORAMA_URL_DOMAIN=https://yourhotel.example.com

# Endpoint POST de dong bo scene (trang /vr360-scene-sync)
# De trong neu backend chua support
VITE_VR360_SCENE_SYNC_ENDPOINT=

# ============ Khac (tuy chon) ============
# Thoi gian cache JSON o browser, don vi gio (mac dinh 12)
VITE_FRONTEND_CACHE_TTL_HOURS=12

# Media ID cua logo. De trong thi app tu fetch tu API settings
VITE_LOGO_MEDIA_ID=

# ===========================================
# Huong dan day du: docs/GETTING_STARTED.md
# Setup khach san moi:  docs/NEW_HOTEL_CHECKLIST.md
# ===========================================

# ============ VR360 Angle Picker ============
# Origin cua dashboard backend duoc phep nhung trang /vr360-angle-picker.html
# (nhieu origin cach nhau dau phay). Mac dinh: https://travel.link360.vn
# VITE_VR360_PICKER_ALLOWED_ORIGINS=https://travel.link360.vn

# ============ VR360 - Luu goc nhin (/vr360-scene-sync) ============
# Mat khau de LUU goc khi chay dev (npm run dev). Bo trong thi mat khau dev la "dev".
# npm run setup tu sinh ngau nhien. Tren server: dat CUNG gia tri vao
# define('VR360_EDITOR_PASSWORD', '...') trong config.php (de trong = tat chuc nang luu).
VR360_EDITOR_PASSWORD=
