# 1. Ưu tiên index.php trước
DirectoryIndex index.php index.html

# BẢO MẬT: Chặn truy cập trực tiếp vào config.php
<FilesMatch "^config\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ===== PERFORMANCE & SECURITY (gop tu out/.htaccess) =====

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching cho asset tinh.
# LUU Y: khong dat cache dai cho .js va .txt o day - vr-data/panorama can luon moi
# (rule no-store cho .txt/.js/.htm nam o phan duoi file nay).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On
RewriteBase /

# 2. Cho phép api-proxy.php được truy cập trực tiếp (cần cho frontend)
RewriteCond %{REQUEST_FILENAME} api-proxy\.php
RewriteRule ^ - [L]

# 2b. Toàn bộ assets/vr-data/ và assets/js/ luôn serve static, không qua index.php
# (parser VR360 cần đọc locale/en.txt, index.htm, script.js từ đây)
RewriteCond %{REQUEST_URI} ^/assets/vr-data/
RewriteRule ^ - [L]

# Tắt LiteSpeed cache cho vr-data để file en.txt luôn được đọc mới nhất
<IfModule mod_headers.c>
    <FilesMatch "\.(txt|js|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

RewriteCond %{REQUEST_URI} ^/assets/js/
RewriteRule ^ - [L]

# 3. Nếu là file assets thật (css, js, images) thì trả về luôn
RewriteCond %{REQUEST_FILENAME} -f

# TRỪ trường hợp là file index.html thì không được trả về trực tiếp,
# phải để index.php xử lý
RewriteCond %{REQUEST_FILENAME} !index\.html
RewriteRule ^ - [L]

# 4. Tất cả những thứ còn lại đẩy về index.php
RewriteRule ^ index.php [L]